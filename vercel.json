{
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "bin",
  "rewrites": [
    {
      "source": "/",
      "destination": "/BounceClassic.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/(.*)\\.(data|mem|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ]
}
